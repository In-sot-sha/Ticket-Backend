DATABASE_URL=postgresql://user:password@localhost:5432/db_name?schema=public
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# ── Email ─────────────────────────────────────────────────────────────────────
# Choose one provider: resend | gmail | smtp
# (If unset: uses Resend when RESEND_API_KEY is set, else Gmail when EMAIL_USER/PASS set)
EMAIL_PROVIDER=gmail

# Shared from address (use your Gmail or verified Resend domain)
EMAIL_FROM="PartyStorm <your_email@gmail.com>"
EMAIL_FROM_ADDRESS=your_email@gmail.com
SUPPORT_EMAIL=support@partystorm.ng
# Optional custom logo for email header (PNG/JPG only — SVG is blocked by Gmail)
# EMAIL_LOGO_URL=https://partystorm.ng/email-icon.png
# When FRONTEND_URL is localhost and you send real email, host images publicly:
# EMAIL_ASSET_BASE=https://partystorm.ng

# ── Option A: Google SMTP (Gmail / Google Workspace) ──────────────────────────
# 1) Google Account → Security → 2-Step Verification ON
# 2) App passwords → generate for "Mail"
# 3) EMAIL_PROVIDER=gmail + EMAIL_USER + EMAIL_PASS (the 16-char app password)
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_16_char_app_password"

# ── Option B: Resend (production domains) ─────────────────────────────────────
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxx
# EMAIL_FROM="PartyStorm <noreply@partystorm.ng>"

# ── Option C: Custom SMTP ─────────────────────────────────────────────────────
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_USER=...
# EMAIL_PASS=...

CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
PORT=33333
NODE_ENV=development

# Local frontend runs on Vite port 5181
FRONTEND_URL=http://localhost:5181
ALLOWED_ORIGINS=https://partystorm.ng,https://www.partystorm.ng,http://localhost:5181,http://127.0.0.1:5181

# WhatsApp Cloud API (server only — never expose these to the frontend)
META_APP_ID=
META_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# These only seed the first WhatsAppConfig row. After that, edit them in Admin → WhatsApp.
WHATSAPP_ENABLED=true
WHATSAPP_SEND_TICKETS=true
WHATSAPP_SEND_OTP=true
WHATSAPP_TICKET_TEMPLATE=partystorm_ticket_confirm
WHATSAPP_OTP_TEMPLATE=partystorm_otp
WHATSAPP_TEMPLATE_LANGUAGE=en

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# OPay Checkout
OPAY_MERCHANT_ID=your_opay_merchant_id_here
OPAY_PRIVATE_KEY=your_opay_private_key_here
OPAY_PUBLIC_KEY=your_opay_public_key_here

# Neon Auth
NEON_ISSUER="https://your-project-id.neonauth.aws.neon.tech/neondb/"
NEON_PROJECT_ID="your-project-id"
